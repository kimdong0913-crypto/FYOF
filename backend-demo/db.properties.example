# 이 파일을 같은 폴더에 db.properties 로 복사한 뒤 값을 채우세요. (db.properties 는 .gitignore 에 포함됨)
DB_NAME=fyof
DB_USER=root
DB_PASSWORD=여기에_비밀번호
# 서비스 계정 키 없이 공개 IP 로 직접 접속하려면 아래 줄 사용 (Cloud SQL 승인된 네트워크에 내 IP 등록 필요)
# spring.datasource.url=jdbc:mysql://<공개IP>:3306/fyof?createDatabaseIfNotExist=true&characterEncoding=UTF-8&serverTimezone=UTC
# Cloud SQL 에 공개 IP 가 없고 비공개 IP 만 있다면 PRIVATE 로 변경
DB_IP_TYPES=PUBLIC
